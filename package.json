{
  "name": "diffsift",
  "version": "0.1.0",
  "description": "Separate the real changes in a TypeScript/JavaScript diff from formatting, renames, and moved code",
  "type": "module",
  "license": "MIT",
  "author": "bottercode",
  "repository": "github:bottercode/diffsift",
  "keywords": ["diff", "semantic-diff", "code-review", "tree-sitter", "typescript", "refactoring", "mcp", "agent-skill"],
  "bin": {
    "diffsift": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "vendor": "bun scripts/vendor-grammars.ts",
    "build": "bun scripts/build.ts",
    "eval": "bun scripts/eval.ts",
    "mutate": "bun scripts/mutate.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "web-tree-sitter": "0.27.1",
    "zod": "4"
  }
}
