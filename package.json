{
  "name": "diffsift",
  "version": "0.1.0",
  "description": "Separate the real changes in a TypeScript/JavaScript diff from formatting, renames, and moved code",
  "type": "module",
  "license": "MIT",
  "author": "bottercode",
  "repository": "github:bottercode/diffsift",
  "homepage": "https://github.com/bottercode/diffsift#readme",
  "keywords": [
    "diff",
    "semantic-diff",
    "code-review",
    "tree-sitter",
    "typescript",
    "refactoring",
    "mcp",
    "agent-skill"
  ],
  "bin": {
    "diffsift": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./schema.json": "./schema/diffsift.schema.v1.json",
    "./wasm/*": "./wasm/*",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "wasm",
    "schema",
    "skills",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "vendor": "bun scripts/vendor-grammars.ts",
    "build": "bun scripts/build.ts",
    "eval": "bun scripts/eval.ts",
    "mutate": "bun scripts/mutate.ts",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "ajv": "8.20.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "web-tree-sitter": "0.27.1",
    "zod": "4"
  }
}
